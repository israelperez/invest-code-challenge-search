{
  "name": "search-mock-api",
  "version": "0.0.1",
  "private": true,
  "description": "Local mock of the Betashares Search API, serving instrument search from data/instruments.json.",
  "scripts": {
    "start": "npm run serve",
    "serve": "nodemon",
    "serve:prod": "node dist/main.js",
    "build": "tsc",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "test": "vitest run",
    "reset-log": "node -e \"require('fs').rmSync(process.env.SEARCH_LOG_FILE || 'data/search-log.json', { force: true })\""
  },
  "dependencies": {
    "@koa/bodyparser": "5.1.1",
    "@koa/cors": "5.0.0",
    "@koa/router": "15.7.0",
    "http-status-codes": "2.3.0",
    "koa": "2.16.4"
  },
  "devDependencies": {
    "@tsconfig/node20": "20.1.2",
    "@types/koa": "2.15.0",
    "@types/koa__cors": "5.0.1",
    "@types/node": "22.13.4",
    "@types/supertest": "7.2.1",
    "nodemon": "3.1.9",
    "prettier": "3.5.1",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "vitest": "4.1.12"
  }
}
