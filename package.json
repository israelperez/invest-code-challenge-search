{
  "name": "search-code-challenge",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "npm run api:install && npm run web:install",
    "dev": "node scripts/dev.mjs",
    "api:install": "npm --prefix api install",
    "web:install": "npm --prefix web install",
    "api": "npm --prefix api start",
    "web": "npm --prefix web run dev",
    "test": "npm --prefix api test && npm --prefix web test"
  }
}
